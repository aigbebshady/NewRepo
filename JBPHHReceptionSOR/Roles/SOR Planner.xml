<?xml version="1.0" encoding="utf-8"?>
<Role xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      id="{D7E0F10C-B3C4-3456-789A-BCDEF0123456}"
      name="SOR Planner"
      ismanaged="0"
      isinherited="1">
  <LocalizedNames>
    <LocalizedName description="SOR Planner" languagecode="1033"/>
  </LocalizedNames>
  <Descriptions>
    <Description description="Plans and Integration (XP) staff role. Can read all SORs and PARs, approve/deny PARs, create and manage tasks, create support requests, and send notifications." languagecode="1033"/>
  </Descriptions>
  <RolePrivileges>
    <!-- jbphh_sor: Read/Write org-wide, no delete -->
    <RolePrivilege name="prvCreatejbphh_sor"    level="4"/>
    <RolePrivilege name="prvReadjbphh_sor"      level="8"/>
    <RolePrivilege name="prvWritejbphh_sor"     level="8"/>
    <RolePrivilege name="prvDeletejbphh_sor"    level="0"/>
    <RolePrivilege name="prvAppendTojbphh_sor"  level="8"/>
    <RolePrivilege name="prvAppendjbphh_sor"    level="8"/>
    <RolePrivilege name="prvAssignjbphh_sor"    level="4"/>
    <!-- jbphh_par: Full CRUD org-wide (XP decides PAR disposition) -->
    <RolePrivilege name="prvCreatejbphh_par"    level="8"/>
    <RolePrivilege name="prvReadjbphh_par"      level="8"/>
    <RolePrivilege name="prvWritejbphh_par"     level="8"/>
    <RolePrivilege name="prvDeletejbphh_par"    level="4"/>
    <RolePrivilege name="prvAppendTojbphh_par"  level="8"/>
    <RolePrivilege name="prvAppendjbphh_par"    level="8"/>
    <RolePrivilege name="prvAssignjbphh_par"    level="8"/>
    <!-- jbphh_task: Full CRUD -->
    <RolePrivilege name="prvCreatejbphh_task"   level="8"/>
    <RolePrivilege name="prvReadjbphh_task"     level="8"/>
    <RolePrivilege name="prvWritejbphh_task"    level="8"/>
    <RolePrivilege name="prvDeletejbphh_task"   level="4"/>
    <RolePrivilege name="prvAssignjbphh_task"   level="8"/>
    <!-- jbphh_support: Full CRUD -->
    <RolePrivilege name="prvCreatejbphh_support" level="8"/>
    <RolePrivilege name="prvReadjbphh_support"   level="8"/>
    <RolePrivilege name="prvWritejbphh_support"  level="8"/>
    <RolePrivilege name="prvDeletejbphh_support" level="4"/>
    <!-- jbphh_notification: Create and Read -->
    <RolePrivilege name="prvCreatejbphh_notification" level="8"/>
    <RolePrivilege name="prvReadjbphh_notification"   level="8"/>
    <RolePrivilege name="prvWritejbphh_notification"  level="8"/>
    <RolePrivilege name="prvDeletejbphh_notification" level="0"/>
    <!-- jbphh_unit: Read/Write (no delete) -->
    <RolePrivilege name="prvCreatejbphh_unit"   level="4"/>
    <RolePrivilege name="prvReadjbphh_unit"     level="8"/>
    <RolePrivilege name="prvWritejbphh_unit"    level="8"/>
    <RolePrivilege name="prvDeletejbphh_unit"   level="0"/>
  </RolePrivileges>
</Role>
