<?xml version="1.0" encoding="utf-8"?>
<Workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          WorkflowId="{A6B9CA15-ECFD-0123-4567-89ABCDEF0123}"
          Name="SOR Approval Workflow"
          Type="1"
          Subprocess="0"
          Category="0"
          Mode="1"
          Scope="4"
          OnDemand="0"
          TriggerOnCreate="0"
          TriggerOnDelete="0"
          TriggerOnUpdate="1"
          AsyncAutodelete="1"
          SyncWorkflowLogOnFailure="1"
          StateCode="1"
          StatusCode="2"
          RunAs="1"
          IsTransacted="1"
          IntroducedVersion="1.0.0.0"
          IsCustomizable="1"
          PrimaryEntity="jbphh_sor">
  <LocalizedNames>
    <LocalizedName description="SOR Approval Workflow" languagecode="1033"/>
  </LocalizedNames>
  <Descriptions>
    <Description description="When an SOR status changes to Approved, updates the approved date, notifies the requesting unit, and creates an approval notification record." languagecode="1033"/>
  </Descriptions>
  <TriggerOnUpdateAttributeList>
    <ActivityPointerTriggerAttribute>jbphh_sorstatus</ActivityPointerTriggerAttribute>
  </TriggerOnUpdateAttributeList>
  <InputParameters/>
  <Steps>
    <!-- Step 1: Check SOR status is Approved -->
    <Step StepId="{4D5E6F7A-0004-0001-0004-000000000001}"
          Name="Check SOR Status is Approved"
          Description="Only proceed when SOR moves to Approved status"
          StepType="4"
          Rank="1"
          Sequence="1">
      <Condition>
        <Expression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <Operands>
            <Operand xsi:type="PropertyOperand">
              <Property name="jbphh_sorstatus"/>
            </Operand>
            <Operand xsi:type="ConstantOperand">
              <Value>64700003</Value><!-- Approved -->
            </Operand>
          </Operands>
          <Operator>Equal</Operator>
        </Expression>
      </Condition>
      <Steps>
        <!-- Step 1a: Set Approved Date -->
        <Step StepId="{4D5E6F7A-0004-0002-0004-000000000002}"
              Name="Set Approved Date"
              Description="Records the date the SOR was approved"
              StepType="2"
              Rank="1"
              Sequence="1"
              EntityName="jbphh_sor"
              Operation="2">
          <Attributes>
            <Attribute name="jbphh_approveddate">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="FunctionExpression">
                  <Function>Now</Function>
                </Expression>
              </Formula>
            </Attribute>
          </Attributes>
        </Step>
        <!-- Step 1b: Create Approval Notification record -->
        <Step StepId="{4D5E6F7A-0004-0003-0004-000000000003}"
              Name="Create SOR Approval Notification"
              Description="Creates a notification record confirming SOR approval"
              StepType="2"
              Rank="2"
              Sequence="2"
              EntityName="jbphh_notification"
              Operation="1">
          <Attributes>
            <Attribute name="jbphh_name">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>SOR Approved: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_sor"/></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_notificationtype">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>64700001</Value><!-- SOR Approved -->
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_relatedsorid">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="LookupExpression">
                  <Entity>jbphh_sor</Entity>
                  <Property name="jbphh_sorid"/>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_message">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>Your Statement of Requirements has been approved by XP. SOR: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_sor"/></Operand>
                    <Operand xsi:type="ConstantOperand"><Value>. Reception support coordination is now in progress.</Value></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_channel">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>Email</Value>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_issent">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>0</Value>
                </Expression>
              </Formula>
            </Attribute>
          </Attributes>
        </Step>
        <!-- Step 1c: Send Email to unit POC -->
        <Step StepId="{4D5E6F7A-0004-0004-0004-000000000004}"
              Name="Send Approval Email to SOR Owner"
              Description="Sends an approval confirmation email to the SOR record owner"
              StepType="7"
              Rank="3"
              Sequence="3"
              EntityName="email"
              Operation="1">
          <Attributes>
            <Attribute name="subject">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>[JBPHH SOR] SOR Approved: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_sor"/></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="description">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>Your Statement of Requirements has been approved. Reception support coordination is now underway. You will receive further updates as your tasks are assigned and support is arranged.</Value>
                </Expression>
              </Formula>
            </Attribute>
          </Attributes>
        </Step>
      </Steps>
    </Step>
    <!-- Step 2: Check SOR status is Denied/On Hold for separate notification -->
    <Step StepId="{4D5E6F7A-0004-0005-0004-000000000005}"
          Name="Check SOR Status Change (Other)"
          Description="Handle other status transitions with a general notification"
          StepType="4"
          Rank="2"
          Sequence="2">
      <Condition>
        <Expression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <Operands>
            <Operand xsi:type="PropertyOperand">
              <Property name="jbphh_sorstatus"/>
            </Operand>
            <Operand xsi:type="ConstantOperand">
              <Value>64700007</Value><!-- On Hold -->
            </Operand>
          </Operands>
          <Operator>Equal</Operator>
        </Expression>
      </Condition>
      <Steps>
        <Step StepId="{4D5E6F7A-0004-0006-0004-000000000006}"
              Name="Create SOR On Hold Notification"
              StepType="2"
              Rank="1"
              Sequence="1"
              EntityName="jbphh_notification"
              Operation="1">
          <Attributes>
            <Attribute name="jbphh_name">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>SOR On Hold: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_sor"/></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_notificationtype">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>64700002</Value><!-- SOR Status Change -->
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_message">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>Your Statement of Requirements has been placed On Hold pending additional information or resources. SOR: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_sor"/></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_channel">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>Email</Value>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_issent">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>0</Value>
                </Expression>
              </Formula>
            </Attribute>
          </Attributes>
        </Step>
      </Steps>
    </Step>
  </Steps>
</Workflow>
