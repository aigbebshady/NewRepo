<?xml version="1.0" encoding="utf-8"?>
<Workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          WorkflowId="{F5A8B914-DBEC-F012-3456-789ABCDEF012}"
          Name="Notify Assignee on Task Assignment"
          Type="1"
          Subprocess="0"
          Category="0"
          Mode="1"
          Scope="4"
          OnDemand="0"
          TriggerOnCreate="1"
          TriggerOnDelete="0"
          TriggerOnUpdate="1"
          AsyncAutodelete="1"
          SyncWorkflowLogOnFailure="1"
          StateCode="1"
          StatusCode="2"
          RunAs="1"
          IsTransacted="1"
          IntroducedVersion="1.0.0.0"
          IsCustomizable="1"
          PrimaryEntity="jbphh_task">
  <LocalizedNames>
    <LocalizedName description="Notify Assignee on Task Assignment" languagecode="1033"/>
  </LocalizedNames>
  <Descriptions>
    <Description description="When a reception task is created or its assignee changes, creates a notification record for the newly assigned user." languagecode="1033"/>
  </Descriptions>
  <TriggerOnUpdateAttributeList>
    <ActivityPointerTriggerAttribute>jbphh_assignedtoid</ActivityPointerTriggerAttribute>
  </TriggerOnUpdateAttributeList>
  <InputParameters/>
  <Steps>
    
    <Step StepId="{3C4D5E6F-0003-0001-0003-000000000001}"
          Name="Check Assigned To is Populated"
          Description="Only proceed if there is an assigned user"
          StepType="4"
          Rank="1"
          Sequence="1">
      <Condition>
        <Expression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <Operands>
            <Operand xsi:type="PropertyOperand">
              <Property name="jbphh_assignedtoid"/>
            </Operand>
            <Operand xsi:type="ConstantOperand">
              <Value xsi:nil="true"/>
            </Operand>
          </Operands>
          <Operator>NotEqual</Operator>
        </Expression>
      </Condition>
      <Steps>
        
        <Step StepId="{3C4D5E6F-0003-0002-0003-000000000002}"
              Name="Create Task Assignment Notification"
              Description="Creates a notification record for the task assignment"
              StepType="2"
              Rank="1"
              Sequence="1"
              EntityName="jbphh_notification"
              Operation="1">
          <Attributes>
            <Attribute name="jbphh_name">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>Task Assigned to You: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_task"/></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_notificationtype">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>64700004</Value>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_recipientid">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="LookupExpression">
                  <Entity>jbphh_task</Entity>
                  <Property name="jbphh_assignedtoid"/>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_message">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="StringConcatenationExpression">
                  <Operands>
                    <Operand xsi:type="ConstantOperand"><Value>A reception support task has been assigned to you: </Value></Operand>
                    <Operand xsi:type="PropertyOperand"><Property name="jbphh_name" entity="jbphh_task"/></Operand>
                    <Operand xsi:type="ConstantOperand"><Value>. Please log in to review the task details and due date.</Value></Operand>
                  </Operands>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_channel">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>Teams</Value>
                </Expression>
              </Formula>
            </Attribute>
            <Attribute name="jbphh_issent">
              <Formula xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <Expression xsi:type="ConstantExpression">
                  <Value>0</Value>
                </Expression>
              </Formula>
            </Attribute>
          </Attributes>
        </Step>
      </Steps>
    </Step>
  </Steps>
</Workflow>
